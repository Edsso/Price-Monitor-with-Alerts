# Copie para `.env` e ajuste. O arquivo `.env` nunca deve ser versionado.

# Scrapers (todos opcionais; os valores abaixo são os padrões)
# SCRAPER_USER_AGENT=Mozilla/5.0 ...
SCRAPER_TIMEOUT_SECONDS=15
SCRAPER_MAX_ATTEMPTS=3
SCRAPER_BACKOFF_SECONDS=1
SCRAPER_MIN_INTERVAL_SECONDS=2

# API do Mercado Livre (crie um app no portal de desenvolvedores)
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=

# Supabase (Project Settings > API Keys)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (service_role): ignora RLS e só pode existir no back-end
SUPABASE_SECRET_KEY=

# Endereços do front-end autorizados (lista JSON)
CORS_ORIGINS=["http://localhost:5173"]
